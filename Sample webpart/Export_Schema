function New-Dir([string] $Path) {
    if (-not (Test-Path $Path)) { New-Item -ItemType Directory -Path $Path | Out-Null }
    (Resolve-Path $Path).Path
}

function Get-SafeName([string] $Name) {
    ($Name -replace '[\\/:*?"<>|]', '_').Trim()
}

function Write-Json($Object, [string] $Path) {
    $Object | ConvertTo-Json -Depth 10 | Set-Content -Path $Path -Encoding utf8
}

function Connect-Site([string] $SiteRelativeUrl) {
    Write-Host "Connecting to $TenantUrl$SiteRelativeUrl ..." -ForegroundColor Cyan
    Connect-PnPOnline -Url ($TenantUrl + $SiteRelativeUrl) -Interactive -ClientId $ClientId -ReturnConnection
}

function Get-FormJsLink($Connection, [string] $FormUrl) {
    try {
        $parts = Get-PnPWebPart -ServerRelativePageUrl $FormUrl -Connection $Connection
        foreach ($wp in $parts) {
            $xml = Get-PnPWebPartXml -ServerRelativePageUrl $FormUrl -Identity $wp.Id -Connection $Connection
            $m = [regex]::Match($xml, '<property name="JSLink"[^>]*>([^<]*)</property>')
            if ($m.Success -and $m.Groups[1].Value) { return $m.Groups[1].Value }
        }
        return $null
    }
    catch { return "error: $($_.Exception.Message)" }
}

function Export-List($Connection, [string] $SiteUrl, [string] $ListId, [string] $SchemaDir) {
    try {
        $list = Get-PnPList -Identity $ListId -Connection $Connection -ThrowExceptionIfListNotFound
    }
    catch {
        Write-Warning "List $ListId not found on $SiteUrl"
        return [pscustomobject]@{ Site = $SiteUrl; Id = $ListId; Found = $false; Error = $_.Exception.Message }
    }

    Get-PnPProperty -ClientObject $list -Property RootFolder, ContentTypes, WorkflowAssociations, Views -Connection $Connection | Out-Null
    $rootUrl = $list.RootFolder.ServerRelativeUrl
    Write-Host "  $($list.Title)  ($rootUrl)"

    $fields = Get-PnPField -List $list -Connection $Connection | ForEach-Object {
        $schema = [xml]$_.SchemaXml
        $choices = @($schema.Field.CHOICES.CHOICE) | Where-Object { $_ }
        [pscustomobject]@{
            InternalName     = $_.InternalName
            Title            = $_.Title
            Type             = $_.TypeAsString
            Required         = $_.Required
            ReadOnly         = $_.ReadOnlyField
            Hidden           = $_.Hidden
            DefaultValue     = $_.DefaultValue
            Description      = $_.Description
            Choices          = $choices
            Format           = $schema.Field.Format
            Min              = $schema.Field.Min
            Max              = $schema.Field.Max
            Decimals         = $schema.Field.Decimals
            Mult             = $schema.Field.Mult
            UserSelectionMode = $schema.Field.UserSelectionMode
            LookupList       = $schema.Field.List
            LookupShowField  = $schema.Field.ShowField
            Formula          = $schema.Field.Formula
            ValidationFormula = $_.ValidationFormula
            ValidationMessage = $_.ValidationMessage
            EnforceUniqueValues = $_.EnforceUniqueValues
            SchemaXml        = $_.SchemaXml
        }
    }

    $forms = $null
    if ($list.BaseType -eq 'GenericList') {
        $forms = [ordered]@{
            NewForm  = Get-FormJsLink $Connection "$rootUrl/NewForm.aspx"
            EditForm = Get-FormJsLink $Connection "$rootUrl/EditForm.aspx"
            DispForm = Get-FormJsLink $Connection "$rootUrl/DispForm.aspx"
        }
    }

    $result = [ordered]@{
        Site                 = $SiteUrl
        Id                   = $list.Id.Guid
        Title                = $list.Title
        Url                  = $rootUrl
        BaseType             = "$($list.BaseType)"
        BaseTemplate         = $list.BaseTemplate
        ItemCount            = $list.ItemCount
        EnableVersioning     = $list.EnableVersioning
        ValidationFormula    = $list.ValidationFormula
        ContentTypes         = @($list.ContentTypes | ForEach-Object { $_.Name })
        Views                = @($list.Views | ForEach-Object { [ordered]@{ Title = $_.Title; Default = $_.DefaultView; Url = $_.ServerRelativeUrl } })
        WorkflowAssociations = @($list.WorkflowAssociations | ForEach-Object { [ordered]@{ Name = $_.Name; Enabled = $_.Enabled } })
        FormJsLinks          = $forms
        Fields               = @($fields)
    }
    Write-Json $result (Join-Path $SchemaDir ((Get-SafeName $list.Title) + '.json'))

    [pscustomobject]@{
        Site = $SiteUrl; Id = $list.Id.Guid; Found = $true; Title = $list.Title; Url = $rootUrl
        ItemCount = $list.ItemCount; FieldCount = @($fields).Count
        Workflows = ($result.WorkflowAssociations | ForEach-Object { $_.Name }) -join '; '
    }
}

