$schemaDir  = New-Dir (Join-Path $OutDir 'schemas')
$uiDir      = New-Dir (Join-Path $OutDir 'legacy-ui')
$pagesDir   = New-Dir (Join-Path $uiDir 'pages')
$missingDir = New-Dir (Join-Path $uiDir 'site-assets-missing')

$index = @()
$mswpoConn = $null
foreach ($site in $listsBySite.Keys) {
    $conn = Connect-Site $site
    if ($site -eq '/sites/wpcb/mswpo') { $mswpoConn = $conn }
    foreach ($id in $listsBySite[$site]) {
        $index += Export-List $conn $site $id $schemaDir
    }
}
Write-Json $index (Join-Path $schemaDir '_index.json')

# --- Classic Site Pages: wiki HTML + web part XML -----------------------------------------------
Write-Host "Exporting Site Pages ..." -ForegroundColor Cyan
$pages = Get-PnPListItem -List 'Site Pages' -Fields 'FileLeafRef', 'FileRef', 'WikiField' -PageSize 500 -Connection $mswpoConn
foreach ($page in $pages) {
    $name = [IO.Path]::GetFileNameWithoutExtension($page['FileLeafRef'])
    $base = Join-Path $pagesDir (Get-SafeName $name)
    if ($page['WikiField']) { Set-Content -Path "$base.wikifield.html" -Value $page['WikiField'] -Encoding utf8 }
    try {
        $parts = Get-PnPWebPart -ServerRelativePageUrl $page['FileRef'] -Connection $mswpoConn
        $i = 0
        foreach ($wp in $parts) {
            $i++
            $xml = Get-PnPWebPartXml -ServerRelativePageUrl $page['FileRef'] -Identity $wp.Id -Connection $mswpoConn
            Set-Content -Path ("$base.webpart$i." + (Get-SafeName $wp.WebPart.Title) + '.xml') -Value $xml -Encoding utf8
        }
        Write-Host "  $($page['FileLeafRef'])  ($i web parts)"
    }
    catch { Write-Warning "  $($page['FileLeafRef']): $($_.Exception.Message)" }
}

# --- Site Assets inventory + files missing from the local export --------------------------------
Write-Host "Inventorying SiteAssets/MSWPO ..." -ForegroundColor Cyan
$assets = Get-PnPFolderItem -FolderSiteRelativeUrl 'SiteAssets/MSWPO' -ItemType File -Recursive -Connection $mswpoConn
$inventory = foreach ($f in $assets) {
    $rel = $f.ServerRelativeUrl -replace '^.*/SiteAssets/MSWPO/', ''
    $localPath = Join-Path $LocalExportDir ($rel -replace '/', '\')
    $inLocal = Test-Path $localPath
    if (-not $inLocal) {
        $target = New-Dir (Join-Path $missingDir (Split-Path ($rel -replace '/', '\') -Parent))
        Get-PnPFile -Url $f.ServerRelativeUrl -Path $target -FileName $f.Name -AsFile -Force -Connection $mswpoConn
    }
    [pscustomobject]@{ Path = $rel; Length = $f.Length; Modified = $f.TimeLastModified; InLocalExport = $inLocal }
}
$inventory | Export-Csv -Path (Join-Path $uiDir 'site-assets.csv') -NoTypeInformation -Encoding utf8

# --- Access Management group names (no personal data) -------------------------------------------
$groups = Get-PnPListItem -List 'B441CA50-2EFB-425F-BF1B-E66EE18806B0' -Connection $mswpoConn | ForEach-Object {
    [pscustomobject]@{ Id = $_.Id; Title = $_['Title']; MemberCount = @($_['Group_x0020_Members']).Count }
}
Write-Json @($groups) (Join-Path $uiDir 'access-groups.json')

Write-Host ""
Write-Host "Done." -ForegroundColor Green
Write-Host "  Lists found: $(@($index | Where-Object Found).Count) / $($index.Count)  -> $schemaDir"
Write-Host "  Pages      -> $pagesDir"
Write-Host "  Missing site-asset files downloaded: $(@($inventory | Where-Object { -not $_.InLocalExport }).Count) -> $missingDir"
